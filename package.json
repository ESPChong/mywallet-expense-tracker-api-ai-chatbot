{
  "name": "mywallet",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace apps/web-app",
    "web:build": "npm run build --workspace apps/web-app",
    "web:start": "npm run start --workspace apps/web-app",
    "web:test": "npm run test --workspace apps/web-app",
    "web:lint": "npm run lint --workspace apps/web-app",
    "web:format": "npm run format --workspace apps/web-app",
    "web:e2e": "npm run e2e --workspace apps/web-app",
    "web:typecheck": "npm run typecheck --workspace apps/web-app",
    "db:push": "npm run db:push --workspace apps/web-app",
    "db:reset": "npm run db:reset --workspace apps/web-app",
    "db:reset:seed": "npm run db:reset:seed --workspace apps/web-app",
    "mobile": "npm run start --workspace apps/mobile-app",
    "mobile:test": "npm run test --workspace apps/mobile-app",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "apps/web-app/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "apps/mobile-app/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {},
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "fsevents@2.3.3": true,
    "core-js-pure@3.50.0": true,
    "unrs-resolver@1.12.2": true,
    "prisma@6.12.0": true
  },
  "overrides": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
